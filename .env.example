# NOTE: BACKEND_MODE has been removed. It documented a "mock" mode that was
# never implemented (no backend/app/services/providers.py exists, and nothing
# branched on the value) — its only effect was making GET /health report a
# healthy "mock" backend on a deployment that could not serve a single
# request. The watsonx.ai and Zilliz credentials below are all required.

# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual
WATSONX_INSTRUCT_MODEL_ID=ibm/granite-4-h-small
WATSONX_INSTRUCT_MODEL_FALLBACK_ID=meta-llama/llama-3-3-70b-instruct

# Gemini — embeddings/retrieval only (see app/services/watsonx.py).
# Generation (/ask's instruct model) is watsonx-only; a Gemini tier there
# was tried and deliberately removed, since generation was never actually
# what failed in production — the embedding call was.
#
# When GEMINI_API_KEY is set, retrieval REPLACES watsonx/Granite embeddings
# with Gemini's gemini-embedding-001 outright, not a fallback — embeddings
# from different providers are different vector spaces, so there's no safe
# way to fail over between them mid-query. This also switches which Zilliz
# collection is queried, from ZILLIZ_COLLECTION_NAME to
# ZILLIZ_COLLECTION_NAME_GEMINI below. That collection has to actually
# contain Gemini-embedded documents before this will retrieve anything —
# re-run `python backend/scripts/ingest_chortlechat_corpus.py` with
# GEMINI_API_KEY set in the environment first (one-time; the corpus is
# already fetched locally at backend/data/chortlechat_corpus.json, so this
# doesn't re-fetch from NASA). Note Gemini's free tier caps embed_content
# at 100 requests/minute — ingesting the whole corpus in one run may need a
# retry after a short wait if it trips that limit.
#
# Leave GEMINI_API_KEY blank to keep watsonx/Granite embeddings, exactly as
# before Gemini support existed. GEMINI_API is also accepted as an
# alternate name for this var (e.g. if that's what a deployment's
# dashboard already has set). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-001

# Zilliz Cloud (managed Milvus)
ZILLIZ_URI=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION_NAME=the_north_star
# Separate collection Gemini-embedded documents live in — never the same
# name as ZILLIZ_COLLECTION_NAME, see the Gemini section above. Defaults to
# ZILLIZ_COLLECTION_NAME + "_gemini" if left blank.
ZILLIZ_COLLECTION_NAME_GEMINI=

# Server
PORT=8000
