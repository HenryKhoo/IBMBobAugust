digraph TechStack {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  compound=true;
  node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#ffffff", color="#888888", fontsize=13, margin="0.15,0.1"];
  edge [fontname="Helvetica", fontsize=11, color="#666666", arrowsize=0.8];

  subgraph cluster_dev {
    label="Development";
    style=dashed; color="#888888"; fontsize=13; fontname="Helvetica-Bold";
    BOB [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6">
      <TR><TD><IMG SRC="logos/sized_ibm-bob.png"/></TD>
      <TD ALIGN="LEFT">IBM Bob<BR ALIGN="LEFT"/>AI coding assistant</TD></TR>
      </TABLE>> fillcolor="#eaf1ff" color="#0f62fe"];
  }

  subgraph cluster_ingest {
    label="Ingestion";
    style=dashed; color="#888888"; fontsize=13; fontname="Helvetica-Bold";
    DOCS [label="NASA SMD passages" fillcolor="#f5f5f5" color="#999999"];
    GRANITE [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6">
      <TR><TD><IMG SRC="logos/sized_granite.png"/></TD>
      <TD ALIGN="LEFT">IBM Granite embedding model<BR ALIGN="LEFT"/>(watsonx.ai)</TD></TR>
      </TABLE>> fillcolor="#eafff0" color="#1a7a3d"];
    ZILLIZ [shape=cylinder label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6">
      <TR><TD><IMG SRC="logos/sized_zilliz.png"/></TD>
      <TD ALIGN="LEFT">Zilliz Cloud<BR ALIGN="LEFT"/>vector index</TD></TR>
      </TABLE>> fillcolor="#eaf1ff" color="#2f6fdb"];
    DOCS -> GRANITE -> ZILLIZ;
  }

  subgraph cluster_runtime {
    label="Runtime — C.O.S.M.O.S.";
    style=dashed; color="#888888"; fontsize=13; fontname="Helvetica-Bold";
    USERQ [label="User question" shape=oval fillcolor="#f5f5f5" color="#999999"];
    API [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6">
      <TR><TD><IMG SRC="logos/sized_fastapi.png"/></TD>
      <TD ALIGN="LEFT">FastAPI<BR ALIGN="LEFT"/>/ask endpoint</TD></TR>
      </TABLE>> fillcolor="#e6faf8" color="#009485"];
    RETRIEVE [label="Retrieve best-match passage" fillcolor="#f5f5f5" color="#999999"];
    SCORE [label="Confidence >= 0.68?" shape=diamond fillcolor="#fff7e0" color="#c98a00"];
    NOMATCH [label="Honest no-match response" fillcolor="#f5f5f5" color="#999999"];
    GEN [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6">
      <TR><TD><IMG SRC="logos/sized_watsonx.png"/></TD>
      <TD ALIGN="LEFT">IBM watsonx.ai<BR ALIGN="LEFT"/>Granite / Mistral instruct</TD></TR>
      </TABLE>> fillcolor="#f2ecff" color="#6b3fd6"];
    ANSWER [label="Grounded answer + citation" fillcolor="#f5f5f5" color="#999999"];
    UI [label="Console frontend" shape=oval fillcolor="#f5f5f5" color="#999999"];

    USERQ -> API;
    API -> RETRIEVE;
    RETRIEVE -> SCORE;
    SCORE -> NOMATCH [label="No"];
    SCORE -> GEN [label="Yes"];
    GEN -> ANSWER;
    NOMATCH -> UI;
    ANSWER -> UI;
  }

  ZILLIZ -> RETRIEVE;
  BOB -> API [style=dashed label="built & maintained"];
  BOB -> UI [style=dashed label="built & maintained"];
}
