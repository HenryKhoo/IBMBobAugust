# NOTE: BACKEND_MODE has been removed. It documented a "mock" mode that was
# never implemented (no backend/app/services/providers.py exists, and nothing
# branched on the value) — its only effect was making GET /health report a
# healthy "mock" backend on a deployment that could not serve a single
# request. The watsonx.ai and Zilliz credentials below are all required.

# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual
WATSONX_INSTRUCT_MODEL_ID=ibm/granite-4-h-small
WATSONX_INSTRUCT_MODEL_FALLBACK_ID=meta-llama/llama-3-3-70b-instruct

# Zilliz Cloud (managed Milvus)
ZILLIZ_URI=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION_NAME=the_north_star

# Server
PORT=8000
